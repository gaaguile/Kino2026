{
  "name": "kino2026",
  "version": "1.0.0",
  "description": "Keeps a history of Chilean Kino draws and charts how often each number comes up.",
  "private": true,
  "scripts": {
    "test": "tsc --noEmit",
    "analyze": "ts-node src/analyze-kino.ts",
    "build-from-xlsx": "ts-node src/build-from-xlsx.ts",
    "verify": "ts-node src/scraper.ts",
    "publish": "ts-node src/publish.ts",
    "notify": "ts-node src/notify.ts",
    "backtest": "ts-node src/backtest.ts",
    "update-latest": "ts-node src/update-latest.ts && ts-node src/analyze-kino.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaaguile/Kino2026.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gaaguile/Kino2026/issues"
  },
  "homepage": "https://github.com/gaaguile/Kino2026#readme",
  "dependencies": {
    "exceljs": "^4.4.0",
    "nodemailer": "^10.5.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.162.0"
  }
}
