# Copy this file to .env and fill it in; .env is git-ignored and must never be
# committed.

# Cloudflare credentials for "npm run publish".
# The token needs the permission Account > Cloudflare Pages > Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Gmail account that sends the email of "npm run notify", with an app password
# (Google account > Security > 2-Step Verification > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Discord channel that gets the same report, styled like the server kit
# (Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL).
# Leave empty to skip Discord.
DISCORD_WEBHOOK_URL=
# Optional picture for the webhook's name, e.g. the 512x512 server icon hosted
# on the web page. Leave empty to use the webhook's own avatar.
DISCORD_AVATAR_URL=

# Who receives the email. Leave empty to send it to GMAIL_USER.
NOTIFY_TO=
